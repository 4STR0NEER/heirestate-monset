{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/all",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(?<site>alto|wave|pristina)\\..+" }],
      "destination": "/:site/"
    },
    {
      "source": "/:file(robots\\.txt|sitemap\\.xml)",
      "has": [{ "type": "host", "value": "(?<site>alto|wave|pristina)\\..+" }],
      "destination": "/:site/:file"
    }
  ]
}
